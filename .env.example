DATABASE_URL=postgres://app:app@localhost:5433/research
REDIS_URL=redis://localhost:6380
PORT=3000
LOG_LEVEL=info
MAX_PROCESSING_ATTEMPTS=3
MAX_PENDING_JOBS_PER_WORKSPACE=20
# Worker child process PDF parse deadline in milliseconds (1-120000).
PDF_EXTRACTION_TIMEOUT_MS=30000
API_REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=10
EMBEDDING_REQUESTS_PER_MINUTE=60
ANSWER_REQUESTS_PER_MINUTE=30
# Set only when traffic reaches the API through this many trusted proxies.
TRUST_PROXY_HOPS=0
# Browser origin and a 32-byte hex key for the Next.js session cookie.
# Generate a fresh key with: openssl rand -hex 32
WEB_PUBLIC_ORIGIN=http://localhost:3001
WEB_SESSION_KEY=
# Optional: at least 32 random characters; enables GET /internal/metrics.
METRICS_TOKEN=
EMBEDDING_PROVIDER=local
# Set EMBEDDING_PROVIDER=openai and provide a key for semantic embeddings.
OPENAI_API_KEY=
# Estimated embedding input price; update when provider pricing changes.
EMBEDDING_USD_PER_MILLION_TOKENS=0.02
LLM_PROVIDER=local
# Set LLM_PROVIDER=openai to generate answers with the OpenAI Responses API.
LLM_MODEL=gpt-4o-mini
# Approximate standard token prices for the default model; check current pricing when changing it.
LLM_INPUT_USD_PER_MILLION_TOKENS=0.15
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0.60
